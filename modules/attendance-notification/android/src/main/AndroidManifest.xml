<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="expo.modules.attendancenotification">
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
  <!-- Android 16 (API 36): lets the attendance notification request the system's promoted/Live Update treatment -->
  <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />

  <application>
    <service
      android:name="expo.modules.attendancenotification.AttendanceForegroundService"
      android:exported="false"
      android:foregroundServiceType="specialUse"
      android:stopWithTask="false">
      <property
        android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
        android:value="attendance-tracking" />
    </service>
  </application>
</manifest>
