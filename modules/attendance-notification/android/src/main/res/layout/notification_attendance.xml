<?xml version="1.0" encoding="utf-8"?>
<!--
  The custom body Android draws below its own system header (app
  icon, app name, the small relative-time badge - all of that comes
  from NotificationCompat.Builder itself via DecoratedCustomViewStyle,
  not from this layout). Fixed height so the notification shows at
  this size immediately, not only after the user expands it.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="160dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="4dp"
    android:paddingEnd="12dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/text_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Attendance Active"
            android:textColor="#000000"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/text_punch_in"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#666666"
            android:textSize="14sp" />
    </LinearLayout>

    <Chronometer
        android:id="@+id/live_timer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#2563EB"
        android:textSize="22sp"
        android:textStyle="bold" />
</LinearLayout>
